#include<iostream>
#include<stack>
#include<vector>
using namespace std;

int main(){
    int t; cin>>t;
    while(t--){
        int n; cin>>n;
        vector<int> v(n), res(n);
        for(auto &x : v) cin>>x;
        stack<pair<int,int>> st;
        for(int i = n-1; i>=0; i--){
            while(true){
                if(st.empty()){
                    res[i] = -1;
                    st.push({v[i],-1});
                    break;
                }
                if(st.top().first <= v[i]) st.pop();
                else{
                    res[i] = st.top().second;
                    
                }
            }
        }
    }
}